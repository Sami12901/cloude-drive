{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "dist/preload",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src/preload/**/*.ts", "src/shared/**/*.ts"]
}

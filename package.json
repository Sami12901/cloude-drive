{
  "name": "cloudssd",
  "productName": "CloudSSD",
  "version": "1.0.0",
  "description": "CloudSSD — mount your existing cloud storage as a real Windows drive letter (Z:\\) using rclone and WinFsp.",
  "license": "MIT",
  "author": "CloudSSD contributors",
  "main": "dist/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n renderer,main -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "npm run build:main && electron .",
    "dev:host": "tsx dev-host/server.ts",
    "dev:full": "concurrently -n host,renderer -c green,cyan \"npm:dev:host\" \"npm:dev:renderer\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && node scripts/write-build-package.mjs",
    "build:preload": "tsc -p tsconfig.preload.json",
    "start": "electron .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:mount": "vitest run --project mount",
    "test:provider": "vitest run --project provider",
    "test:ui": "vitest run --project ui",
    "test:coverage": "vitest run --coverage",
    "deps:check": "tsx scripts/check-dependencies.ts",
    "deps:fetch-rclone": "tsx scripts/fetch-rclone.ts",
    "icons:generate": "node scripts/generate-icons.mjs",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --dir",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "verify:release": "tsx scripts/verify-release.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "3.25.76",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.1",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.2",
    "concurrently": "9.1.2",
    "electron": "38.8.6",
    "electron-builder": "26.18.1",
    "jsdom": "26.1.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "optionalDependencies": {},
  "overrides": {}
}
